{
  "name": "towers",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @towers/server\" \"npm run dev -w @towers/client\"",
    "start": "npm run build -w @towers/client && npm start -w @towers/server",
    "sim": "npm run sim -w @towers/engine --",
    "build": "npm run build -w @towers/client",
    "e2e": "playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
